# 依赖与运行产物
node_modules/
*.log

# 临时文件（建仓脚本等）
.github-create-body.json

# 预览产物（node scripts/build-preview.mjs 生成）
preview/

# Python 编译缓存（测试/自检会生成，别进仓库）
__pycache__/
*.pyc

# 一次性脚本（别进仓库）
tmp-*.mjs

# ── 备份与删除残留（10-31）─────────────────────────────────────────────
# *.bak-<时间戳> 是手工改文件的快照；.douyin-removed-* 是删抖音时移出来的目录。
# 它们不该进仓库：真要回滚用 /home/baka/feiyu-backups/ 的整包备份。
*.bak
*.bak-*
*.bak.*
.douyin-removed-*

# 门禁/测试的临时产物
test/.tmp/
.sandbox/
