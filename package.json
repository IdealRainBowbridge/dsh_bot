{
  "name": "dsh-feiyu",
  "version": "0.4.0",
  "description": "大肥鱼·私享版：一只养在本机的陪伴角色 —— B站自主刷视频写日记、QQ 秒回（语音/表情/主动搭话）、微信替主人回消息、抖音自主观看+评论区经营+私信陪聊。四平台共用同一套人格/情绪/记忆（统一时序回忆、时间常驻、占位符归一、我是谁快照、原文可检索），完全自由+自定唤醒+每日回顾让她自己过日子。所有外发默认关闭，每一项都有独立开关与额度。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "qq",
    "dafeiyu",
    "agent",
    "diary",
    "memory",
    "persona",
    "tts",
    "napcat",
    "sticker"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "client.js",
    "AGENTS.template.md",
    "cordis.patch.yml",
    "README.md",
    "DEPLOY.md"
  ],
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "test:fast": "node test/client-smoke.mjs && node test/stickers-test.mjs && node test/memory-test.mjs",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
